{
  "expo": {
    "name": "iKhono",
    "slug": "ikhono",
    "scheme": "ikhono",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a2d6b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "africa.ikhono.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0a2d6b"
      },
      "package": "africa.ikhono.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow iKhono to access your photos.",
          "cameraPermission": "Allow iKhono to use your camera."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b417bc4-1661-4511-b163-b2d08c6d2cd2"
      }
    },
    "owner": "thobanis-team"
  }
}
